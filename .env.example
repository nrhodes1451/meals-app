# Leave unset for local development: the app falls back to PGlite in .pglite/
# Set to a Neon connection string for deployed environments.
# DATABASE_URL=postgres://user:password@host/db?sslmode=require

# Recipe import from a photo uses Gemini on Vertex AI through Application Default Credentials
# (`gcloud auth application-default login` locally, the service account on Cloud Run).
# All three are optional; these are the defaults.
# GOOGLE_CLOUD_PROJECT=meals-492311
# GOOGLE_CLOUD_LOCATION=global
# RECIPE_IMPORT_MODEL=gemini-3.8-flash
